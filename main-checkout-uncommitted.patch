+.tabbar .tab-active::after, .tabbar .tab-active + .tab::after { display: none; }
+.tabbar .tab-close {
+  width: 18px; height: 18px; flex: none;
+  display: inline-flex; align-items: center; justify-content: center;
+  font-size: var(--fz-body); border-radius: var(--radius-badge);
+}
+.tabbar .tab-add {
+  width: 28px; height: 28px; margin: 0 var(--sp-2);
+  font-size: var(--fz-h2); font-weight: 400;
+  border-radius: var(--radius-btn);
+}
+.app.app-tabs .crumb-row { padding: 0 var(--sp-6); font-size: var(--fz-mini); gap: var(--sp-1); }
+
+/* ── Metadata rail ─────────────────────────────────────────────────────
+   Was mono, uppercase, unicode-glyph-prefixed, and on its own row rhythm.
+   Now it is cards like every other card, with the shared label/value grid. */
+.topic-side { background: var(--bg); }
+.side-card {
+  background: var(--paper);
+  border: 1px solid var(--line);
+  border-radius: var(--radius-card);
+  box-shadow: var(--shadow-card);
+  margin-bottom: var(--sp-3);
+  overflow: hidden;
+}
+.side-card-hd {
+  padding: var(--sp-2) var(--sp-3);
+  border-bottom: 1px solid var(--line);
+  background: var(--paper-2);
+  font-size: var(--fz-micro);
+  letter-spacing: var(--track-caps);
+  text-transform: uppercase;
+  font-weight: 550;
+  color: var(--muted);
+}
+.side-card-body { padding: var(--sp-2) var(--sp-3) var(--sp-3); }
+.side-card-body .side-row:last-child { padding-bottom: 0; }
+.side-card-empty { color: var(--faint); font-size: var(--fz-mini); padding: var(--sp-3); }
+.side-children { display: flex; flex-direction: column; gap: 1px; }
+.side-link {
+  appearance: none; border: 0; background: transparent;
+  display: grid; grid-template-columns: minmax(0,1fr) auto;
+  gap: var(--sp-2); align-items: baseline;
+  width: 100%; text-align: left; cursor: pointer;
+  padding: var(--sp-2); margin: 0 calc(var(--sp-2) * -1);
+  border-radius: var(--radius-badge);
+  font: inherit; font-size: var(--fz-mini); color: var(--fg);
+  transition: background var(--dur-1) var(--ease-out);
+}
+.side-link:hover { background: var(--hover); }
+.side-link-title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.side-link-meta  { font-size: var(--fz-micro); color: var(--faint); white-space: nowrap; }
+/* Actions are buttons, so they look like buttons rather than like links that
+   happen to start with a glyph. */
