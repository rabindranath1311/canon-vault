+  display: flex; align-items: center; gap: var(--sp-2);
+  width: 100%; text-align: left; cursor: pointer;
+  appearance: none;
+  padding: var(--sp-2) var(--sp-3);
+  margin-top: var(--sp-1);
+  border: 1px solid var(--line);
+  border-radius: var(--radius-btn);
+  background: var(--paper);
+  font: inherit; font-size: var(--fz-mini); font-weight: 500;
+  color: var(--fg); text-decoration: none;
+  transition: background var(--dur-1) var(--ease-out),
+              border-color var(--dur-1) var(--ease-out);
+}
+.side-action:hover { background: var(--hover); border-color: var(--i-2); }
+.side-action .lucide { color: var(--faint); }
+.side-action-warn:hover { border-color: var(--signal-alert); color: var(--signal-alert); }
+.side-action-warn:hover .lucide { color: var(--signal-alert); }
+
+/* ── Page header ───────────────────────────────────────────────────────
+   The kind pill, title, timestamp and delete control sat at four different
+   sizes. They are one row now, aligned on a baseline. */
+.page-hd-row { gap: var(--sp-3); }
+.page-kind-pill {
+  padding: 3px var(--sp-2);
+  border-radius: var(--radius-badge);
+  font-size: var(--fz-micro);
+  font-weight: 550;
+  letter-spacing: var(--track-label);
+}
+.page-title-input, .page-title-static {
+  font-size: var(--fz-h1);
+  letter-spacing: var(--track-display);
+  line-height: 1.2;
+}
+.page-meta-side { gap: var(--sp-3); font-size: var(--fz-mini); }
+.page-meta-del, .page-meta-obs { font-size: var(--fz-mini); }
+.chip-strip { gap: var(--sp-2); }
+.chip-strip-l { min-width: 72px; }
+
+/* The title competes with the timestamp + obsidian + delete cluster for a
+   column that is only ~500px once the chat rail is out. The title wins and
+   the cluster wraps beneath it rather than crushing it to an ellipsis. */
+.page-hd-row { flex-wrap: wrap; row-gap: var(--sp-2); }
+.page-title-input, .page-title-static { flex: 1 1 240px; min-width: 180px; }
+.page-meta-side { flex: 0 1 auto; margin-left: auto; }
+
+/* The `// comment` separator was the last of the terminal lineage, and it
+   competed with everything around it — it read as syntax in an interface
+   with no other syntax. The relationship between a heading and its aside is
+   carried by weight and colour instead, with a hairline dot where a break
+   is genuinely needed. */
+.dash-title-c {
+  font-family: var(--font-sans);
+  font-size: var(--fz-mini);
+  color: var(--muted);
+  font-weight: 400;
+  letter-spacing: var(--track-body);
+}
+.dash-title-c::before {
+  content: '';
+  display: inline-block;
+  width: 3px; height: 3px; border-radius: 50%;
+  background: var(--i-2);
+  vertical-align: 0.28em;
+  margin: 0 var(--sp-2);
+}
+.sect-hd-c {
+  font-size: var(--fz-micro);
+  color: var(--faint);
+  letter-spacing: var(--track-label);
+  text-transform: none;
+  font-weight: 400;
+}
+
+/* ═══════════════════════════════════════════════════════════════════════
+   PROJECT PAGE
+   A project is a container, so the page answers three questions in order:
+   what is this, what are the facts about it, what is inside it.
+   ═══════════════════════════════════════════════════════════════════════ */
+
+.project-body { display: flex; flex-direction: column; gap: var(--sp-4); }
+
+/* Summary strip — replaces a card that only restated the page title. */
+.pj-summary {
+  display: flex; align-items: center; flex-wrap: wrap;
+  gap: var(--sp-2) var(--sp-3);
+  padding-bottom: var(--sp-1);
+}
+.pj-summary-empty { color: var(--faint); font-size: var(--fz-mini); }
+.pj-status {
+  display: inline-flex; align-items: center; gap: var(--sp-2);
+  padding: 3px var(--sp-2) 3px var(--sp-2);
+  border: 1px solid var(--line);
+  border-radius: var(--radius-pill);
+  background: var(--paper);
+  font-size: var(--fz-mini); font-weight: 500;
+  color: var(--muted);
+}
+.pj-status-dot {
+  width: 6px; height: 6px; border-radius: 50%;
+  background: currentColor; flex: none;
+}
+.pj-status-planning { color: var(--muted); }
+.pj-status-active   { color: var(--k-proj);      border-color: currentColor; }
+.pj-status-paused   { color: var(--signal-warn); border-color: currentColor; }
+.pj-status-shipped  { color: var(--fg);          border-color: currentColor; }
+.pj-status-archived { color: var(--faint); }
+.pj-dates { font-size: var(--fz-mini); color: var(--muted); }
+
+/* Cards */
+.pj-card {
+  background: var(--paper);
+  border: 1px solid var(--line);
+  border-radius: var(--radius-card);
+  box-shadow: var(--shadow-card);
+  overflow: hidden;
+}
+.pj-card-hd {
+  padding: var(--sp-2) var(--sp-4);
+  border-bottom: 1px solid var(--line);
+  background: var(--paper-2);
+}
+.pj-card-hd-row { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-3); }
+.pj-card-body { padding: var(--sp-4); }
+.pj-card-note {
+  margin: var(--sp-4) 0 0;
+  padding-top: var(--sp-3);
+  border-top: 1px solid var(--line);
+  font-size: var(--fz-mini);
+  color: var(--faint);
+  line-height: 1.55;
+}
+
+/* Description — rendered by default, textarea only while editing. */
+.pj-readme .md-rendered { max-width: var(--measure); }
+.pj-readme .md-edit-ta  { display: none; width: 100%; min-height: 200px; }
+.pj-desc-editing .md-rendered { display: none; }
+.pj-desc-editing .md-edit-ta  { display: block; }
+
+/* Details — a label column and a control column, on the shared rhythm. */
+.pj-field-row {
+  display: grid;
+  grid-template-columns: 84px minmax(0, 1fr);
+  gap: var(--sp-3);
+  align-items: center;
+  padding: var(--sp-2) 0;
+}
+.pj-field-row + .pj-field-row { border-top: 1px solid var(--line-very-soft); }
+.pj-field-l {
+  font-size: var(--fz-micro);
+  letter-spacing: var(--track-caps);
+  text-transform: uppercase;
+  font-weight: 550;
+  color: var(--faint);
+}
+.pj-field {
+  appearance: none;
+  max-width: 260px; width: 100%;
+  padding: 6px var(--sp-2);
+  background: var(--input-bg);
+  border: 1px solid var(--line);
+  border-radius: var(--radius-input);
+  color: var(--fg);
+  font: inherit; font-size: var(--fz-mini);
+}
+.pj-field:disabled { color: var(--faint); background: var(--bg); }
+.pj-field-pair { display: flex; align-items: center; gap: var(--sp-3); flex-wrap: wrap; }
+.pj-check {
+  display: inline-flex; align-items: center; gap: var(--sp-2);
+  font-size: var(--fz-mini); color: var(--muted); cursor: pointer;
+  white-space: nowrap;
+}
+
+/* ── The create picker ─────────────────────────────────────────────────
+   Was six 10px glyph buttons on one line. Now the same shape as the global
+   Create modal, so the vault's kinds are learned once. */
+.pj-add { padding: var(--sp-4) var(--sp-4) 0; }
+.pj-add-toggle { display: inline-flex; align-items: center; gap: var(--sp-2); width: auto; }
+.pj-picker {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(196px, 1fr));
+  gap: var(--sp-2);
+  margin-top: var(--sp-2);
+}
+.pj-picker-card {
+  appearance: none; cursor: pointer; text-align: left;
+  display: grid;
+  grid-template-columns: 22px minmax(0, 1fr);
+  grid-template-areas: "icon label" "icon hint";
+  gap: 2px var(--sp-2);
+  padding: var(--sp-3);
+  background: var(--paper);
+  border: 1px solid var(--line);
+  border-left: 2px solid var(--k-c, var(--line));
+  border-radius: var(--radius-btn);
+  color: var(--fg); font: inherit;
+  transition: background var(--dur-1) var(--ease-out),
+              border-color var(--dur-1) var(--ease-out),
+              box-shadow var(--dur-2) var(--ease-out),
+              transform var(--dur-2) var(--ease-out);
+}
+.pj-picker-card:hover {
+  background: var(--hover);
+  border-color: var(--k-c, var(--i-2));
+  border-left-color: var(--k-c, var(--line));
+  box-shadow: var(--shadow-raised);
+  transform: translate3d(0, -1px, 0);
+}
+.pj-picker-card:active { transform: none; transition-duration: 40ms; }
+.pj-picker-icon {
+  grid-area: icon; align-self: start;
+  color: var(--k-c, var(--muted));
+  font-size: var(--fz-h3); line-height: 1.2;
+}
+.pj-picker-l { grid-area: label; font-size: var(--fz-body); font-weight: 550; }
+.pj-picker-h {
+  grid-area: hint;
+  font-size: var(--fz-micro); color: var(--muted); line-height: 1.45;
+  letter-spacing: var(--track-body);
+}
+
+/* Inside this project */
+.pj-inside .pj-group:first-of-type { margin-top: var(--sp-4); }
+.pj-group { padding: 0 var(--sp-4); margin-top: var(--sp-5); }
+.pj-group:last-child { padding-bottom: var(--sp-4); }
+.pj-group-hd {
+  display: flex; align-items: center; gap: var(--sp-2);
+  margin-bottom: var(--sp-2);
+  padding-bottom: var(--sp-2);
+  border-bottom: 1px solid var(--line);
+}
+.pj-group-icon { display: inline-flex; font-size: var(--fz-body); }
+.pj-group-ct {
+  margin-left: auto;
+  font-variant-numeric: tabular-nums;
+  letter-spacing: var(--track-body);
+}
+.pj-group-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(216px, 1fr));
+  gap: var(--sp-2);
+}
+.pj-inside-card {
+  display: flex; flex-direction: column; gap: var(--sp-1);
+  padding: var(--sp-3);
+  background: var(--paper);
+  border: 1px solid var(--line);
+  border-radius: var(--radius-btn);
+  cursor: pointer;
+}
+.pj-inside-card:hover { background: var(--hover); border-color: var(--k-c, var(--i-2)); }
+.pj-inside-title { font-size: var(--fz-body); font-weight: 500; }
+.pj-empty { color: var(--muted); font-size: var(--fz-mini); line-height: 1.6; padding: var(--sp-4); }
+.pj-empty code {
+  background: var(--paper-2); border: 1px solid var(--line);
+  padding: 1px 5px; border-radius: 4px;
+  font-size: var(--fz-micro); color: var(--fg);
+}
+
+/* .project-body inherits .page-body, which is a height-constrained flex
+   column inside an overflow:hidden .page-main — that layout suits a single
+   full-height editor, but here it squashed the cards and clipped the
+   Details rows. The project page scrolls its own content instead. */
+.project-body {
+  overflow-y: auto;
+  min-height: 0;
+  padding-bottom: var(--sp-6);
+}
+.project-body > * { flex: none; }
+
+/* ═══════════════════════════════════════════════════════════════════════
+   BRAND
+   Monogram + wordmark, both stroked in currentColor so each inherits the
+   theme instead of needing a light and a dark asset.
+   ═══════════════════════════════════════════════════════════════════════ */
+/* The two marks are sized on different axes on purpose. The monogram is
+   compact (1.44:1) so height binds it. The wordmark is 17:1 — height would
+   make it overflow long before it looked right, and at a 10% stroke weight
+   anything under ~10px of cap height renders sub-pixel and turns grey. So
+   the wordmark is sized by WIDTH and allowed to shrink with its container. */
+.brand-mark, .brand-word { display: inline-flex; align-items: center; }
+.brand-mark { flex: none; height: 1.5em; }
+.brand-mark svg { display: block; height: 100%; width: auto; }
+.brand-word { flex: 0 1 auto; min-width: 0; }
+.brand-word svg { display: block; width: 100%; height: auto; }
+
+.tabbar .tab-brand {
+  display: flex; align-items: center;
+  gap: var(--sp-2);
+  color: var(--fg);
+  text-decoration: none;
+  font-size: var(--fz-body);
+  border-right: 1px solid var(--line);
+  transition: opacity var(--dur-1) var(--ease-out);
+}
+.tabbar .tab-brand:hover { opacity: 0.7; }
+/* The brand cell keeps the sidebar's width even though it now holds only the
+   monogram. That is the point: it makes the rule between chrome and content
+   run unbroken down both rows, so the tab bar reads as part of the same grid
+   as the sidebar rather than as a strip laid over it. */
+.tabbar .tab-brand:focus-visible { outline-offset: -3px; }
+.tabbar .tab-brand { justify-content: flex-start; padding-left: var(--sp-4); }
+.app[data-nav="collapsed"] .tabbar .tab-brand { justify-content: center; padding-left: 0; }
+
+/* First run / connect screen — the mark introduces the app before the app
+   itself has rendered. bridge.js writes this markup, so the size is fixed
+   here rather than inherited from a font-size that does not exist yet. */
+.sb-connect-brand {
+  display: flex; align-items: center; gap: 0.7rem;
+  margin-bottom: 2rem;
+  color: var(--fg);
+}
+.sb-connect-brand svg { display: block; }
+/* Modest on purpose — the headline under it carries the screen now, and a
+   240px wordmark over a 40px headline was two things shouting. */
+.sb-connect-brand .brand-mark { height: 24px; }
+.sb-connect-brand .brand-word { width: 164px; }
+
+/* ═══════════════════════════════════════════════════════════════════════
+   COLOUR MODE PICKER
+   In the sidebar footer rather than behind the gear: appearance is the one
+   setting people change on a whim, and a whim does not survive two clicks.
+   Each chip paints its own mode's page and ink, so the control previews the
+   answer instead of naming it.
+   ═══════════════════════════════════════════════════════════════════════ */
+.theme-picker {
+  display: flex; align-items: center; gap: var(--sp-2);
+  padding-bottom: var(--sp-2);
+  margin-bottom: var(--sp-1);
+  border-bottom: 1px solid var(--line);
+}
+.theme-chip {
+  appearance: none; cursor: pointer; padding: 0;
+  width: 18px; height: 18px; flex: none;
+  border-radius: var(--radius-pill);
+  background: var(--chip-bg, var(--paper));
+  /* The ring is the border, so selection does not change the chip's size and
+     the row never reflows as you click along it. */
+  border: 1px solid var(--i-2);
+  box-shadow: 0 0 0 0 var(--accent);
+  transition: box-shadow var(--dur-2) var(--ease-spring),
+              transform var(--dur-2) var(--ease-spring),
+              border-color var(--dur-1) var(--ease-out);
+  position: relative;
+}
+/* The ink dot: without it a chip is just a grey circle and Light and Sepia
+   are nearly indistinguishable at 18px. */
+.theme-chip::after {
+  content: '';
+  position: absolute; inset: 0; margin: auto;
+  width: 6px; height: 6px; border-radius: 50%;
+  background: var(--chip-ink, var(--fg));
+}
+.theme-chip:hover { transform: scale(1.12); border-color: var(--i-3); }
+.theme-chip.on {
+  box-shadow: 0 0 0 2px var(--bg), 0 0 0 3.5px var(--accent);
+  border-color: transparent;
+}
+.theme-chip:active { transform: scale(0.96); transition-duration: 40ms; }
+/* System has no colour of its own, so it shows both — split down the middle. */
+.theme-chip-system {
+  background: linear-gradient(105deg, #faf9f8 0 50%, #09090b 50% 100%);
+}
+.theme-chip-system::after {
+  background: linear-gradient(105deg, #1c1917 0 50%, #fafafa 50% 100%);
+}
+
+/* Collapsed rail: the row wraps to a 2-up grid so the chips stay reachable
+   instead of overflowing a 56px column. */
+.app[data-nav="collapsed"] .theme-picker {
+  display: grid; grid-template-columns: 1fr 1fr;
+  gap: 5px; justify-items: center;
+  padding: 0 0 var(--sp-2);
+}
+
+/* ── Settings: onto the shared scale ───────────────────────────────────
+   This screen predates the type scale and still sized itself in rem, which
+   put its H1 at 22.4px and its inputs at 13.3–13.6px — three sizes that
+   exist nowhere else in the app. Same story for its checkboxes, which
+   rendered at the browser default 13x13 and were the smallest hit targets
+   in the product. */
+.screen.settings h1 { font-size: var(--fz-h1); letter-spacing: var(--track-display); }
+.screen-sub        { font-size: var(--fz-mini); color: var(--muted); }
+.set-sec-hd b      { font-size: var(--fz-micro); }
+.set-sec-sub,
+.set-row-hint      { font-size: var(--fz-mini); color: var(--faint); }
+.set-row-label     { font-size: var(--fz-body); }
+.set-input         { font-size: var(--fz-mini); padding: 6px 10px; border-radius: var(--radius-input); }
+.set-sec           { margin-bottom: var(--sp-5); }
+.set-row           { padding: var(--sp-3) var(--sp-4); gap: var(--sp-5); }
+.set-sec-hd        { padding: var(--sp-2) var(--sp-4); }
+
+/* Checkboxes and radios everywhere, not just here — 13px is below any
+   reasonable hit target and they were rendering at the browser default. */
+input[type="checkbox"], input[type="radio"] {
+  width: 18px; height: 18px;
+  font: inherit;          /* they render no text; this just keeps them on-scale */
+  accent-color: var(--accent);
+  cursor: pointer;
+  flex: none;
+}
+
+/* ── Bento overlay ─────────────────────────────────────────────────────
+   The caption sits on a scrim meant for a photo. On a tile with no image
+   there is no photo, so white-on-white — the empty variant already
+   repositions the overlay, but it kept the light ink. */
+.bento-tile-empty .bento-tile-overlay,
+.bento-tile-empty .bento-tile-title,
+.bento-tile-empty .bento-tile-meta { color: var(--fg); text-shadow: none; }
+/* Where there IS a photo, the caption can land on a bright region as the
+   gradient fades out. A shadow costs nothing and guarantees the text reads
+   whatever the image does. */
+.bento-tile-overlay { text-shadow: 0 1px 2px rgba(0,0,0,0.55); }
+
+/* ── Recent table: shed columns instead of overflowing ─────────────────
+   Six fixed columns need ~640px, which the dashboard does not have once the
+   sidebar and a rail are out. Rather than let it scroll sideways — the one
+   thing the layout rules forbid — it drops the least load-bearing columns
+   first. ID goes before Via; Via goes before Tags; Title and When always
+   survive, because they are what you scan for. */
+/* Narrow: shed Tags, then Via. Kind, Title and When always survive. */
+@media (max-width: 1180px) {
+  .recent-table .recent-th, .recent-table .recent-row,
+  .recent-table .recent-th-novia, .recent-table .recent-row-novia {
+    grid-template-columns: 56px minmax(0, 1fr) 96px;
+  }
+  .recent-table .recent-th > .recent-via-h,
+  .recent-table .recent-row > .recent-via,
+  .recent-table .recent-th > .pages-tags-h,
+  .recent-table .recent-row > .pages-tags { display: none; }
+}
+
+/* The all-pages table has the same exposure at its narrowest. */
+@media (max-width: 900px) {
+  .pages-table:not(.recent-table) .pages-th,
+  .pages-table:not(.recent-table) .pages-row {
+    grid-template-columns: 96px minmax(0, 1fr) 90px;
+  }
+  .pages-table:not(.recent-table) .pages-th > :nth-child(3),
+  .pages-table:not(.recent-table) .pages-row > .pages-tags { display: none; }
+}
+
+/* ═══════════════════════════════════════════════════════════════════════
+   DEPTH LAYER — gradients, washes, dimension
+   Every gradient here is TONAL: mixed from tokens already in the system
+   (--accent, --k-c, the surfaces) rather than from a new brand colour. That
+   is what lets one set of rules work across four modes — a hardcoded wash
+   that looks right on warm paper looks like a smudge on blue-black.
+   Chromium-only, so color-mix() is fair game and does the mixing per-mode.
+   ═══════════════════════════════════════════════════════════════════════ */
+:root {
+  /* How hard the washes push. One number per family, so the whole layer
+     tunes from here instead of from thirty call sites. */
+  --wash-strength: 4%;
+  --wash-edge:     7%;
+  --sheen: rgba(255,255,255,0.55);
+}
+[data-theme="dark"], [data-theme="midnight"] {
+  /* Light-on-dark reads hotter, so the same percentage would glare. */
+  --wash-strength: 7%;
+  --wash-edge:     11%;
+  --sheen: rgba(255,255,255,0.06);
+}
+
+/* A card carrying a kind colour gets a wash of that kind, falling away fast
+   so it tints the corner and never the text. Where there is no kind it falls
+   back to the accent and reads as plain depth. */
+.cv-wash {
+  background-image:
+    radial-gradient(120% 130% at 0% 0%,
+      color-mix(in srgb, var(--k-c, var(--accent)) var(--wash-edge), transparent) 0%,
+      transparent 58%);
+}
+
+/* The page itself. Flat white across 1400px reads as unfinished; a wash this
+   quiet is felt rather than seen, and it gives the cards something to sit on. */
+.app {
+  background-image:
+    radial-gradient(90% 60% at 50% 0%,
+      color-mix(in srgb, var(--accent) 2.5%, transparent) 0%, transparent 70%);
+}
+
+/* Cards get a top sheen — the single cheapest way to make a flat rectangle
+   read as a surface with an edge rather than a shape cut out of the page. */
+.obs-card, .kind-summary-card, .tier-card, .pj-card, .side-card,
+.board-card, .kind-card, .set-sec, .am-sect, .pages-table, .pages-list {
+  background-image: linear-gradient(180deg, var(--sheen) 0, transparent 42px);
+}
+
+/* Hero cards additionally take the kind wash. */
+.obs-card { background-image:
+  radial-gradient(120% 130% at 0% 0%, color-mix(in srgb, var(--accent) var(--wash-edge), transparent) 0%, transparent 58%),
+  linear-gradient(180deg, var(--sheen) 0, transparent 52px); }
+.kind-summary-card, .kind-card, .pj-picker-card { background-image:
+  radial-gradient(130% 140% at 0% 0%, color-mix(in srgb, var(--k-c, var(--accent)) var(--wash-strength), transparent) 0%, transparent 62%),
+  linear-gradient(180deg, var(--sheen) 0, transparent 36px); }
+
+/* The primary action. Inversion is still the system — this only gives the
+   fill a direction so it reads as a raised control rather than a rectangle. */
+.btn-create, .btn.primary, .sb-primary, .btn-primary.cv-cta {
+  background-image: linear-gradient(180deg,
+    color-mix(in srgb, var(--cta-fg) 12%, var(--cta)) 0%, var(--cta) 62%);
+  box-shadow: var(--shadow-card), inset 0 1px 0 color-mix(in srgb, var(--cta-fg) 18%, transparent);
+}
+.btn-create:hover, .btn.primary:hover, .sb-primary:hover {
+  background-image: linear-gradient(180deg,
+    color-mix(in srgb, var(--cta-fg) 20%, var(--cta)) 0%, var(--cta) 70%);
+  box-shadow: var(--shadow-raised), inset 0 1px 0 color-mix(in srgb, var(--cta-fg) 26%, transparent);
+}
+.btn-create:active, .btn.primary:active { box-shadow: var(--shadow-card); }
+
+/* Chrome. A hairline alone leaves the sidebar and the tab bar looking pasted
+   on; a one-sided wash gives them an edge that belongs to the surface. */
+.nav   { background-image: linear-gradient(90deg, transparent, color-mix(in srgb, var(--accent) 2%, transparent)); }
+.tabbar { background-image: linear-gradient(180deg, var(--sheen) 0, transparent 100%); }
+
+/* Kind chips pick up a whisper of their own colour, which is what makes a
+   list scannable by kind without the chips shouting. */
+.kind-chip, .page-kind-pill {
+  background-image: linear-gradient(180deg,
+    color-mix(in srgb, var(--k-c, var(--accent)) 9%, transparent),
+    color-mix(in srgb, var(--k-c, var(--accent)) 4%, transparent));
+}
+
+/* Section rules fade out instead of stopping dead — a hard 1px line running
+   the full width is the loudest thing on a quiet page. */
+.sect-hd, .nav-section::after {
+  border-image: linear-gradient(90deg, var(--line) 0%, color-mix(in srgb, var(--line) 25%, transparent) 70%, transparent 100%) 1;
+}
+
+/* ── Dashboard hero ────────────────────────────────────────────────────
+   The obsession card is the focal point of the whole app's landing screen
+   and was reading as an empty box: a title, three stats, a flat chart and
+   some links, all at the same weight. */
+.obs-grid {
+  /* Was repeat(3, 1fr), so a single theme left two columns of dead space and
+     one card stretched to a third of the screen with nothing in it. */
+  grid-template-columns: repeat(auto-fill, minmax(288px, 1fr));
+}
+.obs-card { position: relative; overflow: hidden; }
+
+.obs-hd { align-items: center; }
+.obs-title {
+  appearance: none; border: 0; background: none; padding: 0;
+  font: inherit; font-size: var(--fz-h2); font-weight: 600;
+  letter-spacing: var(--track-title);
+  color: var(--fg); cursor: pointer; text-align: left;
+  display: inline-flex; align-items: baseline; gap: 1px;
+  transition: color var(--dur-1) var(--ease-out);
+}
+.obs-title:hover { color: var(--accent); }
+.obs-hash { color: var(--faint); font-weight: 400; }
+.obs-title:hover .obs-hash { color: var(--accent); }
+.obs-weight {
+  font-size: var(--fz-micro); font-weight: 550;
+  color: var(--muted);
+  background: var(--paper-2);
+  border: 1px solid var(--line);
+  border-radius: var(--radius-pill);
+  padding: 2px 8px;
+  font-variant-numeric: tabular-nums;
+}
+.obs-stats { display: flex; align-items: center; gap: var(--sp-2); color: var(--muted); }
+.obs-dot {
+  width: 3px; height: 3px; border-radius: 50%;
+  background: var(--i-2); display: inline-block;
+}
+
+/* Sparkline: columns with a floor, and an area wash so it reads as a chart
+   rather than as a row of ticks. */
+.spark {
+  display: flex; align-items: flex-end; gap: 3px;
+  height: 44px; padding: var(--sp-2) 0 0;
+  border-bottom: 1px solid var(--line);
+  position: relative;
+}
+.spark::after {
+  content: ''; position: absolute; inset: auto 0 0 0; height: 60%;
+  background: linear-gradient(180deg, transparent, color-mix(in srgb, var(--accent) 5%, transparent));
+  pointer-events: none;
+}
+.spark-col { flex: 1; min-width: 0; height: 100%; display: flex; align-items: flex-end; }
+.spark-bar {
+  width: 100%;
+  background: linear-gradient(180deg, var(--i-5), color-mix(in srgb, var(--i-5) 55%, transparent));
+  border-radius: 2px 2px 0 0;
+  min-height: 3px;
+}
+/* A day with nothing in it should look like a day with nothing in it — a
+   visible floor, not a gap that reads as a broken chart. */
+.spark-bar-zero { background: var(--i-1); border-radius: 2px; }
+
+.obs-tags { gap: var(--sp-1); }
+.tag-chip-btn {
+  appearance: none; font: inherit; cursor: pointer;
+  transition: border-color var(--dur-1) var(--ease-out), color var(--dur-1) var(--ease-out);
+}
+.tag-chip-btn:hover { border-color: var(--i-3); color: var(--fg); }
+
+.obs-member {
+  display: grid; grid-template-columns: 16px minmax(0,1fr) 14px;
+  gap: var(--sp-2); align-items: center;
+  width: 100%; padding: var(--sp-1) var(--sp-1);
+  margin-inline: calc(var(--sp-1) * -1);
+  border-radius: var(--radius-badge);
+  transition: background var(--dur-1) var(--ease-out), color var(--dur-1) var(--ease-out);
+}
+.obs-member:hover { background: var(--hover); color: var(--fg); }
+.obs-member-t { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+/* The arrow only appears on hover — a row of six permanent arrows is noise,
+   but with none at all the rows do not read as navigable. */
+.obs-member-go {
+  opacity: 0; color: var(--faint);
+  transform: translate3d(-3px,0,0);
+  transition: opacity var(--dur-2) var(--ease-out), transform var(--dur-2) var(--ease-out);
+}
+.obs-member:hover .obs-member-go { opacity: 1; transform: none; }
+
+/* ── Empty states ──────────────────────────────────────────────────────
+   These are the first thing a new vault shows on most screens, so they are
+   the app's first impression more often than the dashboard is. */
+.empty-state {
+  position: relative; overflow: hidden;
+  display: flex; flex-direction: column; align-items: center;
+  gap: var(--sp-2);
+  padding: var(--sp-8) var(--sp-5);
+  text-align: center;
+  background: var(--paper);
+  border: 1px solid var(--line);
+  border-radius: var(--radius-card);
+  box-shadow: var(--shadow-card);
+  background-image:
+    radial-gradient(90% 120% at 50% 0%, color-mix(in srgb, var(--accent) 3.5%, transparent), transparent 60%);
+}
+/* The monogram, oversized and nearly invisible, turns an empty box into a
+   considered blank page. Low enough that it never competes with the text. */
+.empty-state-mark {
+  position: absolute; top: 50%; left: 50%;
+  transform: translate(-50%, -52%);
+  width: 210px; opacity: 0.045;
+  color: var(--fg); pointer-events: none;
+}
+.empty-state-mark .brand-mark { height: auto; width: 100%; }
+.empty-state-msg {
+  position: relative;
+  font-size: var(--fz-h3); font-weight: 550; color: var(--fg);
+  letter-spacing: var(--track-title);
+}
+.empty-state-sub {
+  position: relative;
+  font-size: var(--fz-mini); color: var(--muted);
+  max-width: 44ch; line-height: 1.6;
+}
+.empty-state .btn, .empty-state .btn-create, .empty-state .btn-primary {
+  position: relative; margin-top: var(--sp-2); width: auto;
+}
+
+/* ── Save state ────────────────────────────────────────────────────────
+   Quiet by design: this reassures, it does not announce. It occupies its own
+   width at all times so the header never reflows as the state changes. */
+.save-state {
+  display: inline-flex; align-items: center; gap: 5px;
+  min-width: 62px;
+  font-size: var(--fz-micro); font-weight: 500;
+  color: var(--faint);
+  opacity: 0;
+  transition: opacity var(--dur-2) var(--ease-out), color var(--dur-1) var(--ease-out);
+}
+.save-state[data-state="saving"] { opacity: 1; }
+.save-state[data-state="saved"]  { opacity: 1; color: var(--signal-pos); }
+.save-state[data-state="error"]  { opacity: 1; color: var(--signal-alert); }
+.save-state .lucide { font-size: var(--fz-mini); }
+.save-dot {
+  width: 5px; height: 5px; border-radius: 50%;
+  background: currentColor;
+  animation: cv-pulse 1s ease-in-out infinite;
+}
+@keyframes cv-pulse { 0%,100% { opacity: 0.25; } 50% { opacity: 1; } }
+
+/* ── Mode transition ───────────────────────────────────────────────────
+   Switching palette used to snap. Colour-only transitions carry no
+   vestibular load, so this is safe to animate — and it makes the picker feel
+   like it is doing something rather than reloading the page. */
+.app, .app .nav, .app .tabbar, .app .main,
+.pj-card, .side-card, .obs-card, .pages-table, .pages-list,
+.kind-summary-card, .tier-card, .empty-state {
+  transition: background-color var(--dur-3) var(--ease-out),
+              border-color var(--dur-3) var(--ease-out),
+              color var(--dur-3) var(--ease-out);
+}
+@media (prefers-reduced-motion: reduce) {
+  .save-dot { animation: none !important; opacity: 1 !important; }
+}
+
+/* The shortcut is printed where the action is — a shortcut nobody can
+   discover is a shortcut nobody uses. */
+.modal-hd { justify-content: flex-start; gap: var(--sp-2); }
+.modal-kbd {
+  margin-left: auto;
+  font-family: var(--font-mono);
+  font-size: var(--fz-micro);
+  color: var(--faint);
+  border: 1px solid var(--line);
+  border-radius: 4px;
+  padding: 1px 6px;
+}
+
+/* ═══════════════════════════════════════════════════════════════════════
+   BRAND ACCENTS — adopted from the canon-vault site
+   The site and the app already share the two ramps and the shadow set. What
+   the site had that the app did not is a colour LANGUAGE for the two things
+   the graph is made of:
+
+       a mention is a LINK to another page   → indigo, squared
+       a tag is a LABEL you apply            → lime,  pill
+
+   That is the distinction, and it is worth more than any amount of border
+   tuning: the two objects stop being interchangeable grey rectangles.
+
+   The site only ever ran on a light ground, so the dark-family values below
+   are new — #59620c olive is invisible on zinc-950, and the bright lime that
+   replaces it would glare at the site's weight.
+   ═══════════════════════════════════════════════════════════════════════ */
+:root {
+  --lime:      #e4f222;
+  --lime-ink:  #59620c;   /* readable lime — the fill is the lime, ink is this */
+  --lime-bg:   rgba(228,242,34,0.18);
+  --lime-line: rgba(89,98,12,0.28);
+  --indigo:      #4a52b0;
+  --indigo-bg:   rgba(74,82,176,0.09);
+  --indigo-line: rgba(74,82,176,0.34);
+  /* Full-bleed brand, for the one or two places that want to be a statement. */
+  --brand:      #4f46e5;
+  --brand-deep: #3730a3;
+}
+[data-theme="dark"], [data-theme="midnight"] {
+  /* On a dark ground the roles invert: the lime itself becomes the ink. */
+  --lime-ink:  #d7e64f;
+  --lime-bg:   rgba(228,242,34,0.11);
+  --lime-line: rgba(228,242,34,0.30);
+  --indigo:      #9aa2f0;
+  --indigo-bg:   rgba(122,132,232,0.15);
+  --indigo-line: rgba(154,162,240,0.38);
+  --brand:      #6366f1;
+  --brand-deep: #4338ca;
+}
+
+/* ── Tag — a label you apply. Pill, lime, mono, hash-prefixed. ────────── */
+.tag-chip {
+  display: inline-flex; align-items: center; gap: 1px;
+  font-family: var(--font-mono);
+  font-size: var(--fz-micro);
+  padding: 3px 9px;
+  border-radius: var(--radius-pill);
+  background: var(--lime-bg);
+  border: 1px solid var(--lime-line);
+  color: var(--lime-ink);
+  white-space: nowrap;
+}
+.tag-chip-h { opacity: 0.65; }
+.tag-chip-click { cursor: pointer; }
+.tag-chip-click:hover, .tag-chip-btn:hover {
+  border-color: var(--lime-ink);
+  background: color-mix(in srgb, var(--lime) 26%, transparent);
+  color: var(--lime-ink);
+}
+.tag-chip.rm button { color: currentColor; opacity: 0.55; }
+.tag-chip.rm button:hover { opacity: 1; color: var(--signal-alert); }
+
+/* ── Mention — a link to another page. Squared, indigo, with a link mark. ─ */
+.mention-chip {
+  display: inline-flex; align-items: center; gap: 5px;
+  font-family: var(--font-mono);
+  font-size: var(--fz-micro);
+  padding: 3px 8px;
+  border-radius: var(--radius-badge);      /* squared: it is a node, not a label */
+  background: var(--indigo-bg);
+  border: 1px solid var(--indigo-line);
+  color: var(--indigo);
+  white-space: nowrap;
+}
+.mention-chip:hover { border-color: var(--indigo); background: color-mix(in srgb, var(--indigo) 14%, transparent); }
+.mention-chip-i { display: inline-flex; opacity: 0.75; font-size: var(--fz-mini); }
+.mention-chip-t { max-width: 22ch; overflow: hidden; text-overflow: ellipsis; }
+.mention-chip.rm button { color: currentColor; opacity: 0.55; }
+.mention-chip.rm button:hover { opacity: 1; color: var(--signal-alert); }
+
+/* The same language wherever the two appear in rendered prose, so a #tag in a
+   note body and a #tag in the chip strip are recognisably the same object. */
+.hashtag { color: var(--lime-ink); }
+.mention-link { color: var(--indigo); }
+
+/* ── Kind mark — icon only ─────────────────────────────────────────────
+   A bordered, tinted, labelled box on every row was the loudest thing in a
+   list, and in a table it repeated the column header. The colour carries the
+   kind; the header carries the meaning. */
+.kind-mark {
+  display: inline-flex; align-items: center; justify-content: center;
+  width: 22px; height: 22px;
+  border-radius: var(--radius-badge);
+  color: var(--k-c, var(--muted));
+  background: color-mix(in srgb, var(--k-c, var(--accent)) 10%, transparent);
+  font-size: var(--fz-body);
+  flex: none;
+}
+.kind-mark.lg { width: 26px; height: 26px; font-size: var(--fz-h3); }
+
+/* ── Projects index ────────────────────────────────────────────────────
+   Grouped by status, because a project list exists to answer "what am I
+   actually working on" and a flat grid answers it worst — a project shipped
+   last year sat at the same weight as the live one. Order is Active first,
+   Shipped and Archived last. */
+.projects-groups { display: flex; flex-direction: column; gap: var(--sp-3); }
+.pj-group-sec > .sect-hd { margin-top: var(--sp-5); }
+.pj-group-sec:first-child > .sect-hd { margin-top: var(--sp-4); }
+.projects-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(268px, 1fr));
+  gap: var(--sp-3);
+}
+.project-card {
+  display: flex; flex-direction: column; gap: var(--sp-2);
+  padding: var(--sp-4);
+  background: var(--paper);
+  border: 1px solid var(--line);
+  border-left: 2px solid var(--k-proj);
+  border-radius: var(--radius-card);
+  box-shadow: var(--shadow-card);
+  cursor: pointer;
+  background-image:
+    radial-gradient(130% 140% at 0% 0%, color-mix(in srgb, var(--k-proj) 5%, transparent), transparent 62%),
+    linear-gradient(180deg, var(--sheen) 0, transparent 40px);
+  transition: transform var(--dur-2) var(--ease-out),
+              box-shadow var(--dur-2) var(--ease-out),
+              border-color var(--dur-1) var(--ease-out);
+}
+.project-card:hover { transform: translate3d(0,-2px,0); box-shadow: var(--shadow-raised); }
+.project-card:active { transform: none; transition-duration: 40ms; }
+/* Shipped and archived read back a step — present, clearly not current. */
+.project-card.pj-is-shipped, .project-card.pj-is-archived { opacity: 0.78; border-left-color: var(--i-2); }
+.project-card.pj-is-shipped:hover, .project-card.pj-is-archived:hover { opacity: 1; }
+
+.project-card-hd { display: flex; align-items: center; gap: var(--sp-2); }
+.project-card-glyph { display: inline-flex; color: var(--k-proj); font-size: var(--fz-h3); }
+.project-card-name {
+  flex: 1; min-width: 0;
+  font-size: var(--fz-h3); font-weight: 600;
+  letter-spacing: var(--track-title);
+  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
+}
+.project-card-desc {
+  font-size: var(--fz-mini); color: var(--muted); line-height: 1.55;
+  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
+  overflow: hidden;
+}
+.project-card-desc.dim { color: var(--faint); font-style: italic; }
+.project-card-meta {
+  display: flex; justify-content: space-between; align-items: baseline;
+  gap: var(--sp-2);
+  padding-top: var(--sp-2);
+  border-top: 1px solid var(--line-very-soft);
+  font-size: var(--fz-micro); color: var(--faint);
+  font-variant-numeric: tabular-nums;
+}
+.project-card-when { text-align: right; }
+
+/* Quick-settings popover: one tweak and a way through. */
+.sb-twk-link {
+  display: flex; align-items: center; gap: var(--sp-2);
+  width: 100%; padding: var(--sp-2) var(--sp-2);
+  appearance: none; background: transparent;
+  border: 1px solid var(--line); border-radius: var(--radius-btn);
+  color: var(--fg); font: inherit; font-size: var(--fz-mini);
+  cursor: pointer; text-align: left;
+  transition: background var(--dur-1) var(--ease-out), border-color var(--dur-1) var(--ease-out);
+}
+.sb-twk-link:hover { background: var(--hover); border-color: var(--i-2); }
+.sb-twk-link .lucide { color: var(--faint); }
+
+/* ── ProseEditor ───────────────────────────────────────────────────────
+   One writing surface for every kind. The mono editor / proportional view
+   split is the point: you edit raw markdown, you read prose. */
+.prose-editor { display: flex; flex-direction: column; gap: var(--sp-2); position: relative; }
+.prose-editor-hd {
+  display: flex; align-items: center; justify-content: space-between;
+  gap: var(--sp-3); min-height: 26px;
+}
+.prose-editor-l {
+  font-size: var(--fz-micro); letter-spacing: var(--track-caps);
+  text-transform: uppercase; font-weight: 550; color: var(--muted);
+}
+.md-mode-btn { display: inline-flex; align-items: center; gap: 5px; }
+.prose-editor .md-edit-ta { display: none; width: 100%; }
+.prose-editor.is-editing .md-rendered { display: none; }
+.prose-editor.is-editing .md-edit-ta { display: block; }
+.prose-empty { color: var(--faint); font-size: var(--fz-mini); padding: var(--sp-3) 0; }
+/* Prose is measure-capped by default; a surface can opt out when it sits in
+   a column that is already narrow. */
+.md-rendered.md-wide { max-width: none; }
+
+/* The bookmark context and project description sit inside cards, so their
+   editor should not add a second frame. */
+.bm-section-context .prose-editor, .pj-readme .prose-editor { gap: var(--sp-2); }
+.pj-readme { padding: var(--sp-4); }
+.pj-readme .prose-editor-l { color: var(--muted); }
+
+/* Create picker — the name step for a project. */
+.create-name-form { display: flex; flex-direction: column; gap: var(--sp-3); align-items: flex-start; }
+.create-back { display: inline-flex; align-items: center; gap: 6px; }
+.create-back .flip svg { transform: rotate(180deg); }
+.create-name-l {
+  font-size: var(--fz-micro); letter-spacing: var(--track-caps);
+  text-transform: uppercase; font-weight: 550; color: var(--muted);
+}
+.create-name-row { display: flex; gap: var(--sp-2); width: 100%; }
+.create-name { flex: 1; font-size: var(--fz-body); padding: 9px 12px; }
+.create-name-row .btn-create { width: auto; padding-inline: var(--sp-4); }
+.create-name-h { margin: 0; font-size: var(--fz-mini); color: var(--faint); max-width: 52ch; }
+.create-err { font-size: var(--fz-mini); color: var(--signal-alert); min-height: 1em; }
+
+/* ── Toast ─────────────────────────────────────────────────────────────
+   Bottom-left, clear of the demo banner and the mode picker. One at a time;
+   a stack of toasts is a log, and a log is not what an interruption is for. */
+.cv-toast {
+  /* Above the reconnect/demo banner (z-index 9000) — a toast the banner
+     covers is a toast that does not exist. */
+  /* Bottom-RIGHT. Bottom-left is the sidebar footer's — the mode picker and
+     the vault-status line live there, and a toast landed on top of both. */
+  position: fixed; right: var(--sp-4); bottom: var(--sp-4); z-index: 9500;
+  display: flex; align-items: center; gap: var(--sp-3);
+  max-width: min(460px, calc(100vw - 32px));
+  padding: var(--sp-3) var(--sp-3) var(--sp-3) var(--sp-4);
+  background: var(--paper);
+  border: 1px solid var(--line);
+  border-left: 2px solid var(--accent);
+  border-radius: var(--radius-card);
+  box-shadow: var(--shadow-overlay);
+  font-size: var(--fz-mini); color: var(--fg);
+  animation: cv-toast-in var(--dur-3) var(--ease-spring) both;
+  transform-origin: bottom right;
+}
+@keyframes cv-toast-in {
+  from { opacity: 0; transform: translate3d(0, 10px, 0) scale(.98); }
+  to   { opacity: 1; transform: none; }
+}
+.cv-toast-error { border-left-color: var(--signal-alert); }
+.cv-toast-msg { flex: 1; min-width: 0; }
+.cv-toast-action {
+  appearance: none; cursor: pointer; flex: none;
+  padding: 4px 12px; border-radius: var(--radius-btn);
+  border: 1px solid var(--i-2); background: var(--paper);
+  font: inherit; font-size: var(--fz-mini); font-weight: 550; color: var(--fg);
+  transition: background var(--dur-1) var(--ease-out), border-color var(--dur-1) var(--ease-out);
+}
+.cv-toast-action:hover { background: var(--hover); border-color: var(--i-3); }
+.cv-toast-x {
+  appearance: none; cursor: pointer; flex: none;
+  border: 0; background: none; color: var(--faint);
+  font: inherit; font-size: var(--fz-mini); padding: 2px 4px; line-height: 1;
+}
+.cv-toast-x:hover { color: var(--fg); }
+@media (prefers-reduced-motion: reduce) { .cv-toast { animation-duration: 1ms; } }
+
+/* The demo / reconnect banner is fixed to the bottom edge, so a toast placed
+   there lands underneath it and is never seen. Lift it clear when one is up.
+   Chromium-only app, so :has() is fair game. */
+body:has(.sb-vault-banner) .cv-toast { bottom: calc(var(--sp-4) + 58px); }
+
+/* ── Tier 5: taste, decided ────────────────────────────────────────────
+   F28 · The entrance stagger plays once per session, not on every route
+   change. It reads as craft the first time and as latency by the twentieth,
+   and the app is navigated dozens of times per sitting. `body.cv-settled`
+   is set after the first screen paints. */
+body.cv-settled .pages-table .pages-row,
+body.cv-settled .pages-list .list-row,
+body.cv-settled .pages-board .board-card,
+body.cv-settled .obs-grid .obs-card,
+body.cv-settled .kind-summary .kind-summary-card,
+body.cv-settled .tier-grid .tier-card,
+body.cv-settled .pages-bento .bento-tile {
+  animation-delay: 0ms !important;
+  animation-duration: var(--dur-2) !important;
+}
+body.cv-settled .screen, body.cv-settled .page {
+  animation: cv-fade-in var(--dur-2) var(--ease-out) both;
+}
+
+/* F30 · Sepia was the flattest mode: the wash percentages are tuned per
+   family, and on warm paper an ink-mixed wash all but disappears. Given its
+   own strengths it gets the same felt depth as the others. */
+[data-theme="sepia"] { --wash-strength: 7%; --wash-edge: 11%; --sheen: rgba(255,252,244,.7); }
