+/* ═══════════════════════════════════════════════════════════════════════
+   SYSTEM PASS — one component language
+   The type scale and the uppercase rule are settled above. What is left is
+   the part that made the interface read as several designs arguing: every
+   region had invented its own row rhythm, its own padding, and its own idea
+   of how a label relates to a value. This layer settles those, and adds the
+   sidebar's resize + collapse behaviour.
+   ═══════════════════════════════════════════════════════════════════════ */
+
+/* ── Breathing room ────────────────────────────────────────────────────
+   Screens were padded 18px/24px with 16px section gaps, which on a light
+   ground reads cramped — white shows crowding that black hides. Content
+   gets a wider gutter and sections get real separation. */
+.screen        { padding: var(--sp-6) var(--sp-7) var(--sp-8); }
+.page-screen   { padding: var(--sp-5) var(--sp-6) var(--sp-5); }
+.screen.settings { padding: var(--sp-6) var(--sp-7); max-width: 52rem; }
+[data-density="compact"] .screen      { padding: var(--sp-5) var(--sp-5) var(--sp-7); }
+[data-density="comfortable"] .screen  { padding: var(--sp-7) var(--sp-8) var(--sp-8); }
+
+.sect-hd       { margin: var(--sp-6) 0 var(--sp-3); padding-bottom: var(--sp-2); }
+.screen > .sect-hd:first-of-type { margin-top: var(--sp-5); }
+.dash-hd       { padding-bottom: var(--sp-4); margin-bottom: var(--sp-2); }
+.page-hd       { gap: var(--sp-3); margin-bottom: var(--sp-5); }
+.page-chips-row { gap: var(--sp-2); }
+
+/* Card interiors. 14px was the file's most common padding and it is one step
+   too tight for the type sizes above it. */
+.obs-card, .tier-card, .kind-summary-card, .board-card,
+.am-sect, .kind-card, .pj-card     { padding: var(--sp-4); gap: var(--sp-3); }
+.card-b                            { padding: var(--sp-4); }
+.pages-th, .pages-row, .recent-th, .recent-row {
+  padding: var(--sp-3) var(--sp-4);
+}
+.list-row                          { padding: var(--sp-3) var(--sp-4); }
+.obs-grid, .tier-grid, .kind-summary, .pages-board { gap: var(--sp-3); }
+.kind-summary                      { margin: var(--sp-4) 0 var(--sp-6); }
+
+/* ── Label / value pairs ───────────────────────────────────────────────
+   Six regions each invented their own version of "a small label beside a
+   value": the metadata rail, the about-me fields, the settings rows, the
+   project meta grid, the aside blocks and the tweaks panel. One rhythm now. */
+.side-row, .aside-block .b .row-i, .pj-meta-row, .am-field {
+  display: grid;
+  grid-template-columns: 84px minmax(0, 1fr);
+  gap: var(--sp-3);
+  align-items: baseline;
+  padding: var(--sp-2) 0;
+}
+.side-row-l, .aside-block .b .row-i label, .am-lbl {
+  font-size: var(--fz-micro);
+  letter-spacing: var(--track-caps);
+  text-transform: uppercase;
+  font-weight: 550;
+  color: var(--faint);
+}
+.side-row-v, .aside-block .b .row-i .v {
+  font-size: var(--fz-mini);
+  color: var(--fg);
+  min-width: 0;
+  overflow-wrap: anywhere;
+}
+
+/* ── Sidebar ───────────────────────────────────────────────────────────
+   Resize handle on the right edge, mirroring the activity log's, plus the
+   collapsed icon rail. */
+.nav { position: relative; }
+.nav-resize {
+  position: absolute; top: 0; bottom: 0; right: -3px;
+  width: 7px; z-index: 20; cursor: col-resize;
+  touch-action: none; user-select: none;
+}
+.nav-resize::before {
+  content: ''; position: absolute; top: 0; bottom: 0; left: 3px;
+  width: 1px; background: transparent;
+  transition: background var(--dur-1) var(--ease-out);
+}
+.nav-resize:hover::before, .nav-resize.dragging::before {
+  background: var(--accent);
+  box-shadow: 0 0 0 1px var(--accent);
+}
+.app[data-nav="collapsed"] .nav-resize { display: none; }
+
+.app.app-tabs .nav-create { gap: var(--sp-2); padding: var(--sp-3) var(--sp-3) var(--sp-2); }
+.nav-collapse {
+  flex: 0 0 30px; height: 30px;
+  display: inline-flex; align-items: center; justify-content: center;
+  appearance: none; border: 1px solid transparent; background: transparent;
+  color: var(--faint); cursor: pointer; padding: 0;
+  border-radius: var(--radius-btn);
+  font-size: var(--fz-h3);
+  transition: background var(--dur-1) var(--ease-out), color var(--dur-1) var(--ease-out);
+}
+.nav-collapse:hover { background: var(--hover); color: var(--fg); }
+
+.nav-item      { margin: 1px var(--sp-2); padding: 0 var(--sp-2); gap: var(--sp-2); }
+.nav-section   { padding: var(--sp-4) var(--sp-3) var(--sp-2); }
+.nav-foot      { padding: var(--sp-3); gap: var(--sp-1); }
+.nav-gear      { display: grid; grid-template-columns: 16px 1fr; gap: var(--sp-2);
+                 align-items: center; text-align: left; }
+
+/* Collapsed: labels, counts, section headings and the footer text all go;
+   the icon column stays and centres. Titles carry the names on hover.
+   The rows must get BIGGER here, not smaller — with the label gone the only
+   hit target left is the icon, so each row becomes a square button. */
+.app[data-nav="collapsed"] .nav-lbl,
+.app[data-nav="collapsed"] .nav-item .ct,
+.app[data-nav="collapsed"] .nav-section,
+.app[data-nav="collapsed"] .nav-status-row,
+.app[data-nav="collapsed"] .nav-section::after { display: none; }
+.app[data-nav="collapsed"] .nav-item,
+.app[data-nav="collapsed"] .nav-gear,
+.app[data-nav="collapsed"] .btn-create,
+.app[data-nav="collapsed"] .nav-collapse {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  width: 38px; height: 34px;
+  margin: 2px auto;
+  padding: 0;
+  line-height: 1;
+  border-radius: var(--radius-btn);
+  flex: none;
+}
+.app[data-nav="collapsed"] .nav-icon { font-size: var(--fz-h3); }
+.app[data-nav="collapsed"] .nav-create {
+  flex-direction: column;
+  padding: var(--sp-3) 0 var(--sp-2);
+  gap: var(--sp-1);
+}
+/* With the section headings gone the groups would read as one long strip,
+   so the separation moves to a rule between them. */
+.app[data-nav="collapsed"] .nav-scroll > div + div {
+  border-top: 1px solid var(--line);
+  margin-top: var(--sp-2);
+  padding-top: var(--sp-2);
+}
+.app[data-nav="collapsed"] .nav-foot { padding: var(--sp-2) 0; align-items: center; }
+.app[data-nav="collapsed"] .nav-item::before { left: 1px; top: 20%; bottom: 20%; }
+
+/* ── Tab bar ───────────────────────────────────────────────────────────
+   Brand, search and tabs were three components at three heights with three
+   type treatments. One bar: the brand matches the sidebar width so the
+   vertical rule runs unbroken, search is a real field, tabs are tabs. */
+.app.app-tabs { grid-template-rows: var(--tabbar-h) var(--crumb-h) 1fr; }
+.tabbar .tab-brand {
+  min-width: var(--nav-w); width: var(--nav-w);
+  padding: 0 var(--sp-3);
+  gap: var(--sp-2);
+  font-size: var(--fz-body);
+  font-weight: 600;
+  letter-spacing: var(--track-title);
+  overflow: hidden; white-space: nowrap;
+}
+.tabbar .tab-brand .glyph { width: 9px; height: 9px; flex: none; }
+.tabbar .tab-brand small {
+  font-size: var(--fz-micro);
+  letter-spacing: var(--track-label);
+  color: var(--faint);
+}
+.app[data-nav="collapsed"] .tabbar .tab-brand small,
+.app[data-nav="collapsed"] .tabbar .tab-brand span:not(.glyph) { display: none; }
+.app[data-nav="collapsed"] .tabbar .tab-brand { justify-content: center; }
+
+.tabbar .tab-search {
+  width: 260px; min-width: 180px;
+  padding: 0 var(--sp-3);
+  gap: var(--sp-2);
+  background: transparent;
+  border-right: 1px solid var(--line);
+}
+.tabbar .tab-search-glyph { font-size: var(--fz-body); color: var(--faint); }
+.tabbar .tab-search-input { font-size: var(--fz-mini); }
+.tabbar .tab-search-results { border-radius: 0 0 var(--radius-card) var(--radius-card); }
+.tabbar .tab-search-result { grid-template-columns: 68px 1fr; padding: var(--sp-2) var(--sp-3); }
+.tabbar .tab-search-kind, .search-result-kind, .tb-search-result-kind {
+  font-size: var(--fz-micro); color: var(--faint); letter-spacing: var(--track-label);
+}
+
+.tabbar .tab {
+  padding: 0 var(--sp-2) 0 var(--sp-3);
+  gap: var(--sp-2);
+  min-width: 108px; max-width: 220px;
