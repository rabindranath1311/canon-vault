    {
      "id": "01M0SMX6DZDT2ZF8W3VXH6A44F",
      "kind": "note",
      "path": "notes/Gloss Placement as Structure.md",
      "title": "Gloss Placement as Structure",
      "tags": [
        "reference",
        "typography"
      ],
      "aliases": [
        "Gloss Placement as Structure"
      ],
      "mentions": [
        "Marginalia as Interface"
      ],
      "excerpt": "> The gloss is not adjacent to the text. It is *addressed* to a line, and the > distance between them is the claim. Kept for the second half of the argument rather than the first: everyone agrees the margin carried meaning, and almost nobody has said what that costs a layout engine that can reflow. ",
      "sceneText": "",
