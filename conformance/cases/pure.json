      "### Blank then source (text)\n\nSource: https://example.com/body-line",
      "### Bad source (link)\nSource: javascript:alert(1)\n\nbody",
      "### Escaped (markdown)\n\n\\### Not a boundary\n\\## Attachments\nplain",
      "### Url only (link)\nSource: HTTPS://Example.COM/Path?q=1",
      "### Tabs\t(Web)\t\n\nbody\n\n\n",
      "### First line right away (text)\nno blank line here\nsecond"
    ],
    "write": [
      ["", [{ "title": "New", "body": "fresh" }]],
      ["## Thread\n\n**user** hello\n\n## Attachments\n\n### Old (text)\n\nold body\n\n## Links\n\n- [[Somewhere]]", [{ "title": "Replaced", "body": "new body" }]],
      ["## Attachments\n\n### Old (text)\n\nold body", []],
      ["## Links\n\n- [[Somewhere]]", [{ "title": "Inserted before links", "url": "https://example.com/i" }]]
    ]
