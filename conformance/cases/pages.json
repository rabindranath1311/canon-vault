        { "op": "capture", "capture": { "url": "javascript:alert(1)" } },
        { "op": "capture", "capture": { "url": "https://example.com/as-note", "title": "As a note" }, "settings": { "linkTarget": "note" } },
        { "op": "capture", "capture": { "appendTo": "notes/Journal.md", "text": "appended quote", "note": "#appended note", "tags": ["x y"], "url": "https://example.com/j", "title": "Journal [source]" } },
        { "op": "capture", "capture": { "appendTo": "{{id:notes/Journal.md}}", "mentions": ["Moodboard"] } },
        { "op": "capture", "capture": { "appendTo": "inspo/Moodboard.md", "assetPath": "attachments/first.png", "caption": "Already on the wall" } },
        { "op": "capture", "capture": { "appendTo": "inspo/Moodboard.md", "url": "https://example.com/appended", "caption": "Appended to the wall", "group": "Heroes" } },
        { "op": "capture", "capture": { "appendTo": "inspo/Moodboard.md", "title": "No item here" } },
        { "op": "capture", "capture": { "appendTo": "notes/Gone.md", "note": "too late" } },
        { "op": "capture", "capture": { "appendTo": "notes/Journal.md" } },
        { "op": "capture", "capture": { "target": "wall", "blobText": "bytes", "src": "https://example.com/bad%zzname.png", "wall": "Moodboard" } },
        { "op": "page", "path": "inspo/Moodboard.md" }
      ]
    }
  ]
}
