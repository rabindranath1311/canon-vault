{
  "manifest_version": 3,
  "name": "Canon Clip",
  "version": "0.1.0",
  "description": "Collect interface inspiration — images, screenshots, links and quotes — straight into your Canon Vault folder. No server, no account.",
  "minimum_chrome_version": "116",
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Canon Clip",
    "default_popup": "popup.html",
    "default_icon": { "192": "icons/icon-192.png", "512": "icons/icon-512.png" }
  },
  "icons": { "192": "icons/icon-192.png", "512": "icons/icon-512.png" },
  "options_page": "vault.html",
  "permissions": [
    "contextMenus",
    "storage",
    "unlimitedStorage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "commands": {
    "clip-page": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Clip this page"
    },
    "clip-region": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Clip a region of this page"
    }
  }
}
